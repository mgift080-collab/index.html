
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MoneyTools Hub</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:Arial,sans-serif;
  background:#0f172a;
  color:#fff;
}
header{
  background:#16a34a;
  padding:20px;
  text-align:center;
}
header h1{font-size:32px}
header p{margin-top:8px}

.container{
  max-width:900px;
  margin:auto;
  padding:20px;
}

.card{
  background:#1e293b;
  border-radius:15px;
  padding:20px;
  margin-bottom:20px;
}

h2{color:#22c55e;margin-bottom:10px}

input,button{
  width:100%;
  padding:12px;
  margin-top:10px;
  border:none;
  border-radius:10px;
  font-size:16px;
}

input{background:#e5e7eb}
button{
  background:#16a34a;
  color:white;
  cursor:pointer;
  font-weight:bold;
}

button:hover{background:#15803d}

.result{
  margin-top:15px;
  font-size:20px;
  color:#4ade80;
  font-weight:bold;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.idea{
  background:#334155;
  padding:15px;
  border-radius:12px;
}

footer{
  text-align:center;
  padding:30px;
  color:#94a3b8;
}
.ad{
  background:#facc15;
  color:#000;
  text-align:center;
  padding:15px;
  border-radius:12px;
  font-weight:bold;
}
</style>
</head>

<body>

<header>
  <h1>💰 MoneyTools Hub</h1>
  <p>Free financial tools to help you grow your money</p>
</header>

<div class="container">

<div class="ad">
  Advertisement Space (Google AdSense Later)
</div>

<div class="card">
<h2>Profit Calculator</h2>

<input id="cost" type="number" placeholder="Cost Price (R)">
<input id="sell" type="number" placeholder="Selling Price (R)">
<button onclick="profit()">Calculate Profit</button>

<div id="profitResult" class="result"></div>
</div>

<div class="card">
<h2>Savings Calculator</h2>

<input id="save" type="number" placeholder="Monthly Saving (R)">
<input id="months" type="number" placeholder="Months">
<button onclick="saving()">Calculate Savings</button>

<div id="savingResult" class="result"></div>
</div>

<div class="card">
<h2>Investment Growth</h2>

<input id="amount" type="number" placeholder="Investment (R)">
<input id="rate" type="number" placeholder="Annual Interest %">
<input id="years" type="number" placeholder="Years">
<button onclick="invest()">Calculate Growth</button>

<div id="investResult" class="result"></div>
</div>

<div class="card">
<h2>Percentage Calculator</h2>

<input id="num" type="number" placeholder="Number">
<input id="per" type="number" placeholder="Percent %">
<button onclick="percent()">Calculate</button>

<div id="percentResult" class="result"></div>
</div>

<div class="card">
<h2>🔥 8 Side Hustle Ideas</h2>

<div class="grid">

<div class="idea">Website Blogging</div>
<div class="idea">Affiliate Marketing</div>
<div class="idea">YouTube Shorts</div>
<div class="idea">Sell Digital Products</div>
<div class="idea">Print-on-Demand</div>
<div class="idea">Forex Education</div>
<div class="idea">AI Tools Directory</div>
<div class="idea">Online Calculators</div>

</div>
</div>

<div class="card">
<h2>Affiliate Corner</h2>
<p>Add your affiliate links here later (Takealot, Amazon, Temu, etc.).</p>
</div>

</div>

<footer>
© 2026 MoneyTools Hub | Built by Mpho
</footer>

<script>
function profit(){
let c=Number(cost.value);
let s=Number(sell.value);
let p=s-c;
profitResult.innerHTML="Profit: R "+p.toFixed(2);
}

function saving(){
let m=Number(save.value);
let mon=Number(months.value);
let t=m*mon;
savingResult.innerHTML="Total Savings: R "+t.toFixed(2);
}

function invest(){
let a=Number(amount.value);
let r=Number(rate.value)/100;
let y=Number(years.value);
let total=a*Math.pow(1+r,y);
investResult.innerHTML="Future Value: R "+total.toFixed(2);
}

function percent(){
let n=Number(num.value);
let p=Number(per.value);
let ans=n*p/100;
percentResult.innerHTML=p+"% = "+ans;
}
</script>

</body>
</html>